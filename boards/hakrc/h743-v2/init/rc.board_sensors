#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------

board_adc start

# Internal SPI bus ICM42688P accel/gyro - Gyro 1 on SPI1, CS=PC15
icm42688p start -s -b 1 -R 6

# Internal SPI bus ICM42688P accel/gyro - Gyro 2 on SPI4, CS=PC13
icm42688p start -s -b 4 -R 6

# Internal baro on I2C1 at 0x76
spa06 start -X -b 1 -a 0x76

# OSD on SPI3
atxxxx start -s -b 3

# No external mag by default - if you have one, add it here.
